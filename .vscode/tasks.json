{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: install deps",
      "type": "shell",
      "command": "python -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: run",
      "type": "shell",
      "command": ".venv/bin/uvicorn main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: install deps",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: run",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Fullstack: run all",
      "dependsOn": ["Backend: run", "Frontend: run"],
      "problemMatcher": []
    }
  ]
}
